# App
ENVIRONMENT=dev
SECRET_KEY=replace-with-strong-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720
JWT_ALGORITHM=HS256
CORS_ORIGINS=http://localhost:5173

# Database
POSTGRES_DB=pricing_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/pricing_db

# AI Model
# Free local option: install Ollama, run `ollama pull llama3.1:8b`, then use AI_PROVIDER=ollama.
# Free cloud option: create a free API key at Google AI Studio, then use AI_PROVIDER=gemini.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=45

# Free cloud Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=20

# Paid hosted option. Leave blank when using Ollama or Gemini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=20
WIN_MODEL_VERSION=ollama-llama3.1-8b
FEATURE_SCHEMA_VERSION=schema-v1

# Legacy Azure OpenAI / Foundry fallback. Leave blank unless you still have access.
FOUNDRY_ENDPOINT_URL=
FOUNDRY_API_KEY=
FOUNDRY_MODEL_NAME=gpt-5.4-mini
FOUNDRY_SCORING_ENDPOINT_URL=

# Frontend
VITE_API_URL=http://localhost:8000/api
