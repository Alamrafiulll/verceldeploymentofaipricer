# App
ENVIRONMENT=dev
SECRET_KEY=replace-with-strong-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720
JWT_ALGORITHM=HS256
CORS_ORIGINS=http://localhost:5173

# Database
POSTGRES_DB=pricing_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/pricing_db

# AI Model + Foundry
WIN_MODEL_VERSION=xgb-v1
FEATURE_SCHEMA_VERSION=schema-v1
FOUNDRY_ENDPOINT_URL=
FOUNDRY_API_KEY=
FOUNDRY_MODEL_NAME=gpt-5
FOUNDRY_SCORING_ENDPOINT_URL=

# Frontend
VITE_API_URL=http://localhost:8000/api
